# LightTranslator Environment Configuration
# Copy this file to .env.local and fill in your API key.
#
# DEVELOPMENT ONLY: this variable is inlined into the bundle by Vite in dev
# mode as a convenience fallback for the Gemini provider. Release builds
# ignore it. All providers are normally configured in the app's Settings UI
# (keys are stored in the WebView's localStorage — unencrypted).

# Google Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
